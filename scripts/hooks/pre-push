#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/../lib/workspace.sh"

if [[ "${OKT_SKIP_LOCAL_CHECK:-0}" == 1 ]]; then
  exit 0
fi

script="$repo_root/scripts/local-check.sh"
if [[ ! -x "$script" ]]; then
  printf 'pre-push: %s missing or not executable\n' "$script" >&2
  exit 1
fi

zero="0000000000000000000000000000000000000000"
while read -r _ local_sha _ _; do
  if [[ "$local_sha" == "$zero" ]]; then
    continue
  fi
  OKT_LOCAL_CHECK_SHA="$local_sha" mise exec -- "$script" --pre-push
done
